diff --git a/hw/xtensa/esp32_intc.c b/hw/xtensa/esp32_intc.c
index fed7cf7..6ed3ddb 100644
--- a/hw/xtensa/esp32_intc.c
+++ b/hw/xtensa/esp32_intc.c
@@ -22,20 +22,37 @@
 
 #define IRQ_MAP(cpu, input) s->irq_map[cpu][input]
 
+/* A CPU interrupt line is the OR of every source routed to it. */
+static void esp32_intmatrix_update_line(Esp32IntMatrixState *s, int cpu, int out_index)
+{
+    if (s->outputs[cpu] == NULL) {
+        return;
+    }
+    int level = 0;
+    for (int src = 0; src < ESP32_INT_MATRIX_INPUTS; ++src) {
+        if (IRQ_MAP(cpu, src) == out_index && (s->level[src / 32] & (1u << (src % 32)))) {
+            level = 1;
+            break;
+        }
+    }
+    for (int int_index = 0; int_index < s->cpu[cpu]->env.config->nextint; ++int_index) {
+        if (s->cpu[cpu]->env.config->extint[int_index] == out_index) {
+            qemu_set_irq(s->outputs[cpu][int_index], level);
+            break;
+        }
+    }
+}
+
 static void esp32_intmatrix_irq_handler(void *opaque, int n, int level)
 {
     Esp32IntMatrixState *s = ESP32_INTMATRIX(opaque);
+    if (level) {
+        s->level[n / 32] |= 1u << (n % 32);
+    } else {
+        s->level[n / 32] &= ~(1u << (n % 32));
+    }
     for (int i = 0; i < ESP32_CPU_COUNT; ++i) {
-        if (s->outputs[i] == NULL) {
-            continue;
-        }
-        int out_index = IRQ_MAP(i, n);
-        for (int int_index = 0; int_index < s->cpu[i]->env.config->nextint; ++int_index) {
-            if (s->cpu[i]->env.config->extint[int_index] == out_index) {
-                qemu_set_irq(s->outputs[i][int_index], level);
-                break;
-            }
-        }
+        esp32_intmatrix_update_line(s, i, IRQ_MAP(i, n));
     }
 }
 
@@ -63,10 +80,33 @@ static void esp32_intmatrix_write(void* opaque, hwaddr addr, uint64_t value, uns
     Esp32IntMatrixState *s = ESP32_INTMATRIX(opaque);
     uint8_t* map_entry = get_map_entry(s, addr);
     if (map_entry != NULL) {
+        int cpu = (addr / sizeof(uint32_t)) / ESP32_INT_MATRIX_INPUTS;
+        uint8_t old_index = *map_entry;
         *map_entry = value & 0x1f;
+        if (old_index != *map_entry && cpu < ESP32_CPU_COUNT) {
+            esp32_intmatrix_update_line(s, cpu, old_index);
+            esp32_intmatrix_update_line(s, cpu, *map_entry);
+        }
     }
 }
 
+/* DPORT_PRO_INTR_STATUS_0..2 followed by DPORT_APP_INTR_STATUS_0..2 */
+static uint64_t esp32_intmatrix_status_read(void* opaque, hwaddr addr, unsigned int size)
+{
+    Esp32IntMatrixState *s = ESP32_INTMATRIX(opaque);
+    return s->level[(addr / sizeof(uint32_t)) % ARRAY_SIZE(s->level)];
+}
+
+static void esp32_intmatrix_status_write(void* opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+}
+
+static const MemoryRegionOps esp_intmatrix_status_ops = {
+    .read =  esp32_intmatrix_status_read,
+    .write = esp32_intmatrix_status_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
 static const MemoryRegionOps esp_intmatrix_ops = {
     .read =  esp32_intmatrix_read,
     .write = esp32_intmatrix_write,
@@ -77,6 +117,7 @@ static void esp32_intmatrix_reset_hold(Object *obj, ResetType type)
 {
     Esp32IntMatrixState *s = ESP32_INTMATRIX(obj);
     memset(s->irq_map, INTMATRIX_UNINT_VALUE, sizeof(s->irq_map));
+    memset(s->level, 0, sizeof(s->level));
     for (int i = 0; i < ESP32_CPU_COUNT; ++i) {
         if (s->outputs[i] == NULL) {
             continue;
@@ -108,6 +149,9 @@ static void esp32_intmatrix_init(Object *obj)
     memory_region_init_io(&s->iomem, obj, &esp_intmatrix_ops, s,
                           TYPE_ESP32_INTMATRIX, ESP32_INT_MATRIX_INPUTS * ESP32_CPU_COUNT * sizeof(uint32_t));
     sysbus_init_mmio(sbd, &s->iomem);
+    memory_region_init_io(&s->status_iomem, obj, &esp_intmatrix_status_ops, s,
+                          TYPE_ESP32_INTMATRIX ".status", 6 * sizeof(uint32_t));
+    sysbus_init_mmio(sbd, &s->status_iomem);
 
     qdev_init_gpio_in(DEVICE(s), esp32_intmatrix_irq_handler, ESP32_INT_MATRIX_INPUTS);
 }
